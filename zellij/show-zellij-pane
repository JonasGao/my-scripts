#!/bin/bash
# Show detailed information for a specific zellij pane
# Usage: show-zellij-pane [pane_id]
# Example: show-zellij-pane          # show current pane (auto-detect via env)
#          show-zellij-pane 484
#          show-zellij-pane terminal_484

if [ -z "$1" ]; then
    if [ -n "$ZELLIJ_PANE_ID" ]; then
        echo "[Auto-detected current pane: $ZELLIJ_PANE_ID]"
        echo
        PANE_ID="$ZELLIJ_PANE_ID"
    else
        echo "Usage: show-zellij-pane [pane_id]"
        echo
        echo "If inside a zellij session, run without argument to show current pane."
        echo "Otherwise, provide a pane ID:"
        echo "  show-zellij-pane 484"
        echo "  show-zellij-pane terminal_484"
        echo
        echo "Zellij environment variables not found (not in a zellij session?)"
        exit 1
    fi
else
    PANE_ID="$1"
fi

# Remove "terminal_" prefix if present
PANE_NUM="${PANE_ID#terminal_}"

python3 -c "
import json
import subprocess
import sys

pane_id = '$PANE_NUM'

# Get all panes with full details
result = subprocess.run(['zellij', 'action', 'list-panes', '--json', '-a'], capture_output=True, text=True)
if result.returncode != 0:
    print('Error: Failed to get pane list', file=sys.stderr)
    sys.exit(1)

panes = json.loads(result.stdout) if result.stdout else []

# Find the matching pane
found = None
for p in panes:
    if str(p.get('id')) == pane_id:
        found = p
        break

if not found:
    print(f'Error: Pane {pane_id} not found', file=sys.stderr)
    print('Available panes:', file=sys.stderr)
    for p in panes:
        if not p.get('is_plugin'):
            print(f\"  terminal_{p['id']}: {p.get('title', '')[:50]}\", file=sys.stderr)
    sys.exit(1)

# Display formatted output
print(f\"Pane ID: terminal_{found['id']}\")
print(f\"Title: {found.get('title', '')}\")
print(f\"Tab: {found.get('tab_name', '')} (ID: {found.get('tab_id', '')})\")
print()
print('Command & Directory:')
print(f\"  Command: {found.get('pane_command', '(none)')}\")
print(f\"  CWD: {found.get('pane_cwd', '(none)')}\")
print()
print('State:')
print(f\"  Focused: {found.get('is_focused', False)}\")
print(f\"  Fullscreen: {found.get('is_fullscreen', False)}\")
print(f\"  Floating: {found.get('is_floating', False)}\")
print(f\"  Suppressed: {found.get('is_suppressed', False)}\")
print(f\"  Exited: {found.get('exited', False)}\")
print(f\"  Held: {found.get('is_held', False)}\")
print()
print('Geometry:')
print(f\"  Position: ({found.get('pane_x', 0)}, {found.get('pane_y', 0)})\")
print(f\"  Size: {found.get('pane_columns', 0)} x {found.get('pane_rows', 0)}\")
print(f\"  Content offset: ({found.get('pane_content_x', 0)}, {found.get('pane_content_y', 0)})\")
print(f\"  Content size: {found.get('pane_content_columns', 0)} x {found.get('pane_content_rows', 0)}\")
print()
print('Appearance:')
print(f\"  Default FG: {found.get('default_fg', '(default)')}\")
print(f\"  Default BG: {found.get('default_bg', '(default)')}\")
print()
print('Raw JSON:')
print(json.dumps(found, indent=2, ensure_ascii=False))
"
