import shutil
import socket
import subprocess
import sys
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PROTECTED_BRANCHES = {"master", "main", "develop"}

STATUS_LABELS = {
    "orphan": "无上游",
    "gone": "远程已删除",
    "tracking-other": "追踪其他分支",
    "normal": "正常",
}

COLOR = {
    "green": "\033[0;32m",
    "red": "\033[0;31m",
    "yellow": "\033[0;33m",
    "blue": "\033[0;34m",
    "dim": "\033[2m",
    "reset": "\033[0m",
}


def c(text, color, enabled=True):
    if not enabled:
        return text
    return f"{COLOR[color]}{text}{COLOR['reset']}"


def git(repo, *args, timeout=None):
    """运行 git 命令，返回 (returncode, stdout)。不经 shell。"""
    try:
        proc = subprocess.run(
            ["git", "-C", repo, *args],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return 124, ""
    return proc.returncode, proc.stdout


class Branch:
    def __init__(self, name):
        self.name = name
        self.upstream = ""
        self.track = ""
        self.ahead = 0
        self.behind = 0
        self.worktree = ""
        self.commit_time = ""
        self.commit_author = ""
        self.unpushed = 0
        self.dirty = False
        self.dirty_files = []
        self.status = "normal"
        self.protected = ""

    def dirty_diff(self, limit=2000):
        """返回工作区未提交改动的 diff 文本（含未跟踪文件的内容）。"""
        if not self.worktree:
            return ""
        rc, out = git(self.worktree, "diff", "HEAD")
        if rc != 0:
            rc, out = git(self.worktree, "diff")
        chunks = [out] if rc == 0 and out.strip() else []

        for line in self.dirty_files:
            if not line.startswith("??"):
                continue
            name = line[3:]
            path = os.path.join(self.worktree, name)
            if not os.path.isfile(path):
                chunks.append(f"新增文件（未跟踪）: {name}\n")
                continue
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    content = fh.read()
            except OSError as exc:
                chunks.append(f"新增文件（未跟踪）: {name}\n读取失败: {exc}\n")
                continue
            chunks.append(f"新增文件（未跟踪）: {name}\n")
            for row in content.splitlines():
                chunks.append(f"+{row}")
            chunks.append("")

        if not chunks:
            return ""
        lines = "\n".join(chunks).splitlines()
        if len(lines) > limit:
            lines = lines[:limit] + [f"... (已截断，共 {len(lines)} 行)"]
        return "\n".join(lines)

    @property
    def is_orphan(self):
        return self.status in ("orphan", "gone")

    @property
    def warning(self):
        if self.dirty:
            return "有未提交改动（删除会一并丢弃）"
        return ""

    def as_dict(self):
        return {
            "name": self.name,
            "upstream": self.upstream,
            "track": self.track,
            "ahead": self.ahead,
            "behind": self.behind,
            "worktree": self.worktree,
            "commit_time": self.commit_time,
            "commit_author": self.commit_author,
            "unpushed": self.unpushed,
            "dirty": self.dirty,
            "status": self.status,
            "status_label": STATUS_LABELS.get(self.status, self.status),
            "protected": self.protected,
        }


def parse_track(track):
    """把 'ahead 2, behind 1' 这类 upstream:track 文本解析成 (ahead, behind)。"""
    ahead = behind = 0
    for part in track.split(","):
        part = part.strip()
        if part.startswith("ahead "):
            ahead = int(part[6:] or 0)
        elif part.startswith("behind "):
            behind = int(part[7:] or 0)
    return ahead, behind


def worktree_map(repo):
    """返回 (branch -> worktree path, main worktree path)。"""
    rc, out = git(repo, "worktree", "list", "--porcelain")
    if rc != 0:
        return {}, ""
    mapping = {}
    main_path = ""
    path = ""
    for line in out.splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
            if not main_path:
                main_path = path
        elif line.startswith("branch refs/heads/"):
            mapping[line[len("branch refs/heads/"):]] = path
    return mapping, main_path


def scan(repo, current_branch):
    mapping, _ = worktree_map(repo)

    rc, out = git(
        repo,
        "for-each-ref",
        "--format=%(refname:short)%00%(upstream:short)%00%(upstream:track)%00%(committerdate:iso-strict)%00%(authorname)",
        "refs/heads/",
    )
    if rc != 0:
        print("错误: 无法读取分支列表", file=sys.stderr)
        sys.exit(1)

    branches = []
    for line in out.splitlines():
        if not line.strip():
            continue
        fields = line.split("\0")
        if len(fields) < 5:
            continue
        name, upstream, track, commit_time, author = fields[:5]
        b = Branch(name)
        b.upstream = upstream
        b.track = track
        b.commit_time = commit_time
        b.commit_author = author
        b.ahead, b.behind = parse_track(track)
        b.worktree = mapping.get(name, "")

        if not upstream:
            b.status = "orphan"
        elif "gone" in track:
            b.status = "gone"
        else:
            remote_branch = upstream.split("/", 1)[-1]
            b.status = "normal" if remote_branch == name else "tracking-other"

        rc_count, count_out = git(
            repo, "rev-list", "--count", f"refs/heads/{name}", "--not", "--remotes"
        )
        if rc_count == 0 and count_out.strip():
            b.unpushed = int(count_out.strip())

        if b.worktree:
            rc_st, st_out = git(repo, "-C", b.worktree, "status", "--porcelain")
            if rc_st == 0 and st_out.strip():
                b.dirty = True
                b.dirty_files = [line for line in st_out.splitlines() if line.strip()]

        if name in PROTECTED_BRANCHES:
            b.protected = "主干分支"
        elif name == current_branch:
            b.protected = "当前分支"
        elif b.unpushed > 0:
            b.protected = f"{b.unpushed} 个未推送 commit"

        branches.append(b)

    branches.sort(key=lambda b: (0 if b.is_orphan else 1, b.name))
    return branches


def deletion_plan(branch, main_worktree, repo):
    """返回该分支要执行的步骤列表（人类可读）。"""
    steps = []
    if branch.worktree and branch.worktree != main_worktree:
        steps.append(f"git worktree remove -f {branch.worktree}")
    steps.append(f"git branch -D {branch.name}")
    return steps


def delete_branch(repo, branch, main_worktree):
    """执行删除，返回 (ok, message)。"""
    if branch.worktree and branch.worktree != main_worktree:
        path = branch.worktree
        if os.path.isdir(path):
            rc, _ = git(repo, "worktree", "remove", "-f", path)
            if rc != 0:
                shutil.rmtree(path, ignore_errors=True)
                git(repo, "worktree", "prune")
        else:
            git(repo, "worktree", "prune")

    rc, out = git(repo, "branch", "-D", branch.name)
    if rc != 0:
        return False, out.strip() or "git branch -D 失败"
    return True, ""


def print_branch_table(branches, color):
    for b in branches:
        label = STATUS_LABELS.get(b.status, b.status)
        mark = "x" if b.is_orphan else "-"
        if b.is_orphan:
            head = c(f"[{mark}] {b.name}", "green", color)
        elif b.protected:
            head = c(f"[{mark}] {b.name}", "dim", color)
        else:
            head = f"[{mark}] {b.name}"

        details = [label]
        if b.upstream:
            track = []
            if b.ahead:
                track.append(f"↑{b.ahead}")
            if b.behind:
                track.append(f"↓{b.behind}")
            details.append(b.upstream + (" " + " ".join(track) if track else ""))
        if b.worktree:
            details.append(f"worktree: {b.worktree}")
        if b.commit_time:
            details.append(b.commit_time[:19].replace("T", " "))
        if b.commit_author:
            details.append(b.commit_author)
        if b.unpushed:
            details.append(f"未推送 {b.unpushed}")

        print(f"  {head}")
        print(f"      {c(' | '.join(details), 'dim', color)}")
        if b.protected:
            print(f"      {c('保护: ' + b.protected, 'yellow', color)}")
        if b.warning:
            print(f"      {c('⚠ ' + b.warning, 'yellow', color)}")


def fetch_prune(repo):
    print("正在 git fetch --prune ...", end="", flush=True)
    rc, _ = git(repo, "fetch", "--prune", timeout=15)
    if rc == 124:
        print(c(" 超时，按本地已知状态判定", "yellow"))
        return False
    if rc != 0:
        print(c(" 失败，按本地已知状态判定", "yellow"))
        return False
    print(c(" 完成", "green"))
    return True


def cleanable(branches):
    """可清理的分支：孤儿且未被保护规则拦住。"""
    return [b for b in branches if b.is_orphan and not b.protected]


def run_terminal(repo, branches, main_worktree, dry_run, color):
    orphans = cleanable(branches)
    if not orphans:
        print("没有需要清理的无远程分支的本地分支。")
        print()
        print(c("提示: 有上游但没有 worktree 的 feature 分支可能已合并，可手动检查。", "dim", color))
        return 0

    print(f"发现 {len(orphans)} 个需要删除的分支:")
    for b in orphans:
        line = f"  - {b.name}  ({STATUS_LABELS[b.status]})"
        if b.warning:
            line += c(f"  ⚠ {b.warning}", "yellow", color)
        print(line)
        if b.dirty and b.dirty_files:
            for entry in b.dirty_files[:10]:
                print(f"      {c(entry, 'dim', color)}")
            if len(b.dirty_files) > 10:
                print(f"      {c(f'... 另有 {len(b.dirty_files) - 10} 个文件', 'dim', color)}")
    print()

    if dry_run:
        print(c("--dry-run: 以下命令不会执行", "yellow", color))
        for b in orphans:
            for step in deletion_plan(b, main_worktree, repo):
                print(f"  {step}")
        return 0

    try:
        answer = input("确认删除以上分支及其 worktree 吗？[y/N] ").strip()
    except EOFError:
        answer = ""
    print()
    if answer.lower() != "y":
        print("已取消清理。")
        return 0

    ok_count = 0
    failures = []
    for b in orphans:
        ok, msg = delete_branch(repo, b, main_worktree)
        if ok:
            ok_count += 1
            print(c(f"  ✓ 已删除 {b.name}", "green", color))
        else:
            failures.append((b.name, msg))
            print(c(f"  ✗ 删除 {b.name} 失败: {msg}", "red", color))

    print()
    print(f"完成: 成功 {ok_count} 个" + (f"，失败 {len(failures)} 个" if failures else ""))
    return 1 if failures else 0


