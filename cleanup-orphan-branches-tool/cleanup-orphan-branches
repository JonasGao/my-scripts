def render_page(repo, branches, result_html="", dry_run=False):
    rows = []
    for b in branches:
        show_upstream = html.escape(b.upstream)
        if b.ahead or b.behind:
            marks = []
            if b.ahead:
                marks.append(f"↑{b.ahead}")
            if b.behind:
                marks.append(f"↓{b.behind}")
            show_upstream += " " + " ".join(marks)
        commit = html.escape(b.commit_time[:19].replace("T", " "))
        if b.commit_author:
            commit += f"<br><span class=\"muted\">{html.escape(b.commit_author)}</span>"
        notes = []
        if b.protected:
            notes.append(f"保护: {html.escape(b.protected)}")
        if b.warning:
            notes.append(html.escape(b.warning))
        if b.dirty:
            safe = urllib.parse.quote(b.name)
            notes.append(f'<a href="/diff?branch={safe}">查看改动</a>')
        rows.append(
            ROW.format(
                row_class="orphan" if b.is_orphan else ("protected" if b.protected else ""),
                is_orphan="1" if b.is_orphan else "0",
                name=html.escape(b.name),
                checked="checked" if (b.is_orphan and not b.protected) else "",
                disabled="disabled" if b.protected else "",
                status=html.escape(b.status),
                status_label=html.escape(STATUS_LABELS.get(b.status, b.status)),
                upstream=show_upstream + (f"<br>未推送 {b.unpushed}" if b.unpushed else ""),
                worktree=html.escape(b.worktree),
                commit=commit,
                notes="<br>".join(notes),
            )
        )

    return PAGE.format(
        repo_name=html.escape(os.path.basename(repo)),
        branch_count=len(branches),
        orphan_count=len(cleanable(branches)),
        rows="\n".join(rows),
        result=result_html,
        action="/delete" if not dry_run else "/preview",
        button_label="预览将要执行的命令" if dry_run else "删除勾选的分支",
        quit_label="退出",
    )


def render_result(items, dry_run):
    if dry_run:
        lines = ['<div class="result"><strong>将要执行（未执行）</strong><ul>']
        for name, steps in items:
            lines.append(f'<li><span class="mono">{html.escape(name)}</span><ul>')
            for step in steps:
                lines.append(f'<li class="mono muted">{html.escape(step)}</li>')
            lines.append("</ul></li>")
        lines.append("</ul></div>")
        return "".join(lines)

    ok = [n for n, success, _ in items if success]
    failed = [(n, m) for n, success, m in items if not success]
    lines = [f'<div class="result"><strong>完成：成功 {len(ok)} 项']
    if failed:
        lines.append(f'，<span class="warn">失败 {len(failed)} 项</span>')
    lines.append("</strong><ul>")
    for name in ok:
        lines.append(f'<li>✓ <span class="mono">{html.escape(name)}</span></li>')
    for name, msg in failed:
        lines.append(
            f'<li class="warn">✗ <span class="mono">{html.escape(name)}</span> — {html.escape(msg)}</li>'
        )
    lines.append("</ul></div>")
    return "".join(lines)


def render_diff_page(branch):
    files = []
    for line in branch.dirty_files:
        status = line[:2]
        path = line[3:]
        files.append(
            f'<li><span class="mono status">{html.escape(status)}</span> '
            f'<span class="mono">{html.escape(path)}</span></li>'
        )

    diff_text = branch.dirty_diff()
    if diff_text:
        hunks = []
        for line in diff_text.splitlines():
            cls = ""
            if line.startswith("+++") or line.startswith("---"):
                cls = "meta"
            elif line.startswith("+"):
                cls = "add"
            elif line.startswith("-"):
                cls = "del"
            elif line.startswith("@@"):
                cls = "hunk"
            hunks.append(f'<span class="{cls}">{html.escape(line)}</span>')
        diff_html = f'<pre class="diff">{"".join(hunks)}</pre>'
    else:
        diff_html = '<p class="muted">没有可显示的 diff（可能是未跟踪文件或改动已被暂存）。</p>'

    return f"""<!DOCTYPE html>
