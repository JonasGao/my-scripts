def make_handler(repo, branches, main_worktree, dry_run, state):
    by_name = {b.name: b for b in branches}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            pass

        def _send(self, code, body, ctype="text/html; charset=utf-8"):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            parsed = urllib.parse.urlsplit(self.path)
            if parsed.path == "/diff":
                query = urllib.parse.parse_qs(parsed.query)
                name = (query.get("branch") or [""])[0]
                b = by_name.get(name)
                if b is None:
                    self._send(404, "分支不存在", "text/plain; charset=utf-8")
                    return
                self._send(200, render_diff_page(b))
                return
            if parsed.path != "/":
                self._send(404, "not found", "text/plain; charset=utf-8")
                return
            self._send(200, render_page(repo, branches, dry_run=dry_run))

        def do_POST(self):
            if state["done"]:
                self._send(409, "本轮已处理完毕", "text/plain; charset=utf-8")
                return
            path = self.path.split("?")[0]
            if path == "/quit":
                state["done"] = True
                state["exit"] = 0
                self._send(200, "已退出", "text/plain; charset=utf-8")
                print(c("收到退出请求，服务已关闭。", "yellow"))
                return
            if path not in ("/delete", "/preview"):
                self._send(404, "not found", "text/plain; charset=utf-8")
                return

            length = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(length).decode("utf-8", "replace")
            selected = urllib.parse.parse_qs(raw).get("branch", [])

            targets = []
            for name in selected:
                b = by_name.get(name)
                if b is None:
                    continue
                if b.protected:
                    print(f"跳过受保护分支: {name} ({b.protected})", file=sys.stderr)
                    continue
                targets.append(b)

            if not targets:
                self._send(200, render_page(repo, branches, '<div class="result warn">未选择任何可删除的分支</div>', dry_run))
                return

            state["done"] = True

            if dry_run:
                items = [(b.name, deletion_plan(b, main_worktree, repo)) for b in targets]
                self._send(200, render_page(repo, branches, render_result(items, True), dry_run))
                print()
                print(c("预览（未执行）:", "yellow"))
                for name, steps in items:
                    print(f"  {name}")
                    for step in steps:
                        print(f"    {step}")
                print()
                state["exit"] = 0
                return

            items = []
            for b in targets:
                steps = deletion_plan(b, main_worktree, repo)
                ok, msg = delete_branch(repo, b, main_worktree)
                items.append((b.name, ok, msg))
                mark = c("✓", "green") if ok else c("✗", "red")
                print(f"  {mark} {b.name}" + (f" — {msg}" if msg else ""))

            self._send(200, render_page(repo, branches, render_result(items, False), dry_run))

            ok_count = sum(1 for _, success, _ in items if success)
            failed = [(n, m) for n, success, m in items if not success]
            print()
            print(f"完成: 成功 {ok_count} 个" + (f"，失败 {len(failed)} 个" if failed else ""))
            for name, msg in failed:
                print(f"  失败 {name}: {msg}")
            print()
            state["exit"] = 1 if failed else 0

    return Handler


def lan_urls(port):
    urls = []
    try:
        hostname = socket.gethostname()
        for info in socket.getaddrinfo(hostname, None, socket.AF_INET):
            ip = info[4][0]
            if ip.startswith("127."):
                continue
            urls.append(f"http://{ip}:{port}/")
    except OSError:
        pass
    deduped = []
    for url in urls:
        if url not in deduped:
            deduped.append(url)
    return deduped


def bind_server(bind_addr, port, handler):
    if port:
        try:
            return ThreadingHTTPServer((bind_addr, port), handler), port
        except OSError:
            print(c(f"端口 {port} 不可用，改用随机端口", "yellow"))
    srv = ThreadingHTTPServer((bind_addr, 0), handler)
    return srv, srv.server_address[1]


def run_web(repo, branches, main_worktree, bind_addr, port, dry_run, color):
    orphans = cleanable(branches)
    if not orphans:
        print("没有需要清理的无远程分支的本地分支。")
        print()
        print(c("提示: 有上游但没有 worktree 的 feature 分支可能已合并，可手动检查。", "dim", color))
        return 0

    state = {"done": False, "exit": 0}
    handler = make_handler(repo, branches, main_worktree, dry_run, state)
    server, actual_port = bind_server(bind_addr, port, handler)

    print()
    print(c("Web 服务已启动", "green"))
    print(f"  http://127.0.0.1:{actual_port}/")
    for url in lan_urls(actual_port):
        print(f"  {url}")
    print()
    print(c("注意: 服务无认证，同网段知道地址的人都能提交删除请求。", "yellow"))
    print(c("      操作完成后进程会自动退出。", "yellow"))
    print()

    try:
        while not state["done"]:
            server.handle_request()
    except KeyboardInterrupt:
        print("\n已中断。")
        server.server_close()
        return 130

    server.server_close()
    return state["exit"]


def main():
    parser = argparse.ArgumentParser(
        description="清理无远程分支的本地分支及其 worktree",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""示例:
  cleanup-orphan-branches                  # 当前仓库，终端交互
  cleanup-orphan-branches ~/repo --web     # 指定仓库，网页操作
  cleanup-orphan-branches --web --port 8080 --bind 192.168.1.10
  cleanup-orphan-branches --dry-run        # 只预览，不执行
""",
    )
    parser.add_argument("repo", nargs="?", default=".", help="仓库路径（默认当前目录）")
    parser.add_argument("--web", action="store_true", help="启动网页界面进行勾选")
    parser.add_argument("--dry-run", action="store_true", help="只列出将要执行的命令，不执行")
    parser.add_argument("--port", type=int, default=0, help="Web 服务端口（默认随机）")
    parser.add_argument("--bind", default="0.0.0.0", help="Web 服务绑定地址（默认 0.0.0.0）")
    parser.add_argument("--no-fetch", action="store_true", help="跳过启动时的 git fetch --prune")
    args = parser.parse_args()

    color = sys.stdout.isatty()

    repo = os.path.abspath(args.repo)
    if not os.path.isdir(repo):
        print(f"错误: 目录不存在: {repo}", file=sys.stderr)
        return 1
    rc, _ = git(repo, "rev-parse", "--git-dir")
    if rc != 0:
        print(f"错误: 不是 git 仓库: {repo}", file=sys.stderr)
        return 1

    print("=" * 40)
    print(f"仓库: {os.path.basename(repo)}")
    print("=" * 40)
    print()

    if not args.no_fetch:
        fetch_prune(repo)
        print()

    rc, out = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    current_branch = out.strip() if rc == 0 else ""

    print("检查本地分支状态...")
    print()
    branches = scan(repo, current_branch)
    print_branch_table(branches, color)
    print()

    _, main_worktree = worktree_map(repo)

    if args.web:
        return run_web(repo, branches, main_worktree, args.bind, args.port, args.dry_run, color)
    return run_terminal(repo, branches, main_worktree, args.dry_run, color)


if __name__ == "__main__":
    sys.stdout.reconfigure(line_buffering=True)
    sys.exit(main())
